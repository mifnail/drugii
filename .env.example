# =============================================================================
# Файл конфигурации проекта «ДругИИ»
# Скопируйте в .env и заполните свои значения:
#   cp .env.example .env
# =============================================================================

# --- Токены ботов ---
# Токен Telegram бота (получить у @BotFather)
BOT_TOKEN_TG=

# Токен MAX бота (платформа MAX.ru)
BOT_TOKEN_MAX=

# --- Прокси для Telegram (например локальный xray/v2ray) ---
# SOCKS5: socks5://127.0.0.1:10808
# HTTP:   http://127.0.0.1:10809
# Пусто = подключение напрямую
# TG_PROXY=socks5://127.0.0.1:10808

# --- URL платформы MAX ---
# Базовый URL API MAX (по умолчанию для platform-api2)
# MAX_API_URL=https://platform-api2.max.ru

# --- Режим приёма обновлений MAX ---
# longpoll (по умолчанию) — работает локально, без домена и HTTPS
# webhook — нужен публичный HTTPS URL (WEBHOOK_PUBLIC_URL)
# MAX_MODE=longpoll

# --- База данных ---
# Путь к файлу SQLite (по умолчанию data/drugii.db в корне проекта)
# DATABASE_PATH=data/drugii.db

# --- Параметры Bluetooth сканера ---
# Интервал между циклами сканирования (секунды)
# SCAN_INTERVAL=30

# Минимальное время между повторными приветствиями одного устройства (секунды)
# GREETING_COOLDOWN=3600

# Минимальный «возраст» обнаружения перед отправкой приветствия (секунды)
# GREETING_MIN_AGE=30

# --- Webhook сервер ---
# Хост для webhook сервера (0.0.0.0 — доступ извне, требует WEBHOOK_SECRET)
# WEBHOOK_HOST=127.0.0.1

# Порт для webhook сервера
# WEBHOOK_PORT=8080

# --- Веб-интерфейс оператора ---
# Порт HTML-панели для управления связками «пользователь ↔ устройство»
# Отдельный от webhook порт, по умолчанию 8081
# WEB_UI_PORT=8081

# Публичный HTTPS URL вебхука для регистрации на платформе MAX
# Например: https://drugii.example.ru
# WEBHOOK_PUBLIC_URL=

# Секрет для аутентификации входящих webhook-запросов от MAX
# Задайте случайную строку (минимум 16 символов)
# WEBHOOK_SECRET=

# --- GigaChat (генерация приветствий нейросетью) ---
# Client ID и Client Secret через двоеточие, закодированные в base64
# GIGACHAT_CREDENTIALS=<base64(client_id:client_secret)>
# Scope авторизации (GIGACHAT_API_PERS — для физлиц)
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель (GigaChat-3-Ultra, GigaChat-Pro, GigaChat-Plus, GigaChat)
# GIGACHAT_MODEL=GigaChat-3-Ultra
# Базовый URL API (по умолчанию https://api.giga.chat/v1)
# GIGACHAT_BASE_URL=https://api.giga.chat/v1

# --- Логирование ---
# Уровень логирования: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO